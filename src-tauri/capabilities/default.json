{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: events, window controls and the app's own settings, Today, Jobs, Google Sheets and diagnostics commands; no fs, shell, http or path access (threat model T5)",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "allow-get-settings",
    "allow-choose-vault-folder",
    "allow-get-today",
    "allow-save-google-config",
    "allow-connect-google",
    "allow-disconnect-google",
    "allow-get-applications",
    "allow-refresh-applications",
    "allow-get-jobs",
    "allow-log-error",
    "allow-get-diagnostics"
  ]
}
