{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: events, its own title bar (drag, double-click to maximise, minimise, maximise, close) and the app's own settings, Today, Jobs, Fitness, Projects, Health, Money (read, quick add, changing one row's category and CSV import from text the UI read, which write only ledger rows through the safe writer), setup checklist, sample data, Google Sheets, diagnostics and update commands (the updater plugin itself is not exposed); no fs, shell, http or path access (threat model T5)",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "allow-get-settings",
    "allow-choose-vault-folder",
    "allow-choose-health-folder",
    "allow-clear-health-folder",
    "allow-get-today",
    "allow-save-google-config",
    "allow-connect-google",
    "allow-disconnect-google",
    "allow-get-applications",
    "allow-refresh-applications",
    "allow-get-jobs",
    "allow-get-fitness",
    "allow-get-projects",
    "allow-get-health",
    "allow-get-money",
    "allow-add-transaction",
    "allow-set-transaction-category",
    "allow-get-banks",
    "allow-preview-import",
    "allow-import-csv",
    "allow-add-split",
    "allow-settle-up",
    "allow-log-error",
    "allow-get-diagnostics",
    "allow-set-auto-update",
    "allow-check-for-update",
    "allow-install-update",
    "allow-get-setup",
    "allow-skip-setup-item",
    "allow-unskip-setup-item",
    "allow-dismiss-setup",
    "allow-get-mode",
    "allow-enter-sample-mode",
    "allow-exit-sample-mode"
  ]
}
